  "nodes": {
    "start": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major",
        "description": "校门外的人潮在雨雾里移动，伞沿彼此碰撞，湿透的香樟叶贴在路边。",
        "arrival": "你站在雨里，校服袖口已经洇深。三五步外，一个撑伞的女孩停下来等你。"
      },
      "segments": [
        {
          "text": "十四年前。",
          "speaker": "系统"
        },
        {
          "text": "你叫林厌。女孩穿着洁白校服，身量比你略高，伞柄握在修长的手指间。"
        },
        {
          "text": "她是陈初南。你已经很久没有这样清楚地看见她。"
        }
      ],
      "chapterTitle": "序章：故梦",
      "progress": 1,
      "ambient": "rain",
      "choices": [
        {
          "text": "走近陈初南",
          "next": "ch00_rain_02"
        }
      ]
    },
    "ch00_rain_02": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "鞋底踏进积水，雨声立刻近了一层。"
        },
        {
          "text": "林厌，愣着干什么？快跟上，去我家吃饭。",
          "speaker": "陈初南"
        },
        {
          "text": "人潮从身后挤来，她朝你伸出手。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "握住她的手",
          "next": "ch00_rain_touch_cb"
        },
        {
          "text": "“初南。”",
          "next": "ch00_rain_call_cb"
        }
      ]
    },
    "ch00_rain_touch_cb": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "你先碰到她的指尖。那只手温暖、干燥，像雨从来没有落到她身上。"
        },
        {
          "text": "陈初南反手扣住你的手腕，把你拉向伞下。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "跟上她",
          "next": "ch00_rain_04"
        }
      ]
    },
    "ch00_rain_call_cb": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "名字出口时很轻，几乎被雨声盖住。"
        },
        {
          "text": "陈初南还是听见了。她回头看你，伸出的手没有收回。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "把手递给她",
          "next": "ch00_rain_04"
        }
      ]
    },
    "ch00_rain_04": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "她一用力，你跌进伞下，肩膀撞到她的手臂。"
        },
        {
          "text": "陈初南替你拢好滑落的书包带，伞面向你这边偏了偏。"
        },
        {
          "text": "雨水沿着她另一侧肩线流下去。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "替她把伞推正",
          "next": "ch00_rain_05"
        }
      ]
    },
    "ch00_rain_05": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "伞柄回到两人中间，她的肩膀仍旧湿了一小块。"
        },
        {
          "text": "说过多少次，下雨记得带伞。马上期中考，感冒了怎么办？",
          "speaker": "陈初南"
        },
        {
          "text": "她絮絮地数落着，手却一直没有松开。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "看向她握住你的手",
          "next": "ch00_rain_06"
        }
      ]
    },
    "ch00_rain_06": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "她腕间的脉搏隔着薄薄皮肤跳动。"
        },
        {
          "text": "你收紧五指，那点温度便更清楚地贴上来。"
        },
        {
          "text": "陈初南停住话头，侧脸看你。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "“你回来了？”",
          "next": "ch00_rain_07",
          "changes": {
            "val": 2
          }
        }
      ]
    },
    "ch00_rain_07": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "她被你拉得微微俯身。"
        },
        {
          "text": "回哪里？我不是一直在这儿吗？",
          "speaker": "陈初南"
        },
        {
          "text": "她笑了一下，熟悉的眉眼在伞影下渐渐清晰。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "抬头看清她",
          "next": "ch00_rain_08"
        }
      ]
    },
    "ch00_rain_08": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "那双本该映着天光的眼睛里没有瞳孔，只剩两个黑洞。",
          "effect": "blur"
        },
        {
          "text": "血从眼下缓慢淌过苍白脸颊，她的笑容仍停在原处。"
        },
        {
          "text": "陈初南握着你的手，指尖一点点变冷。"
        }
      ],
      "progress": 1,
      "effect": "cold",
      "choices": [
        {
          "text": "碰一下她眼下的血",
          "next": "ch00_rain_blood_cb"
        },
        {
          "text": "扯开被她握住的手腕",
          "next": "ch00_rain_break_cb"
        }
      ]
    },
    "ch00_rain_blood_cb": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "指腹擦过那道血，触感黏冷。"
        },
        {
          "text": "你闻见极淡的腐败气味，和解剖台上没有完全散尽的味道相同。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "检查她的手",
          "next": "ch00_rain_10"
        }
      ]
    },
    "ch00_rain_break_cb": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "你猛地向后挣，陈初南的指甲从腕骨上滑过去。"
        },
        {
          "text": "那层皮肤冰凉而滑腻，摩擦间像要从骨头上脱落。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "看向她的手",
          "next": "ch00_rain_10"
        }
      ]
    },
    "ch00_rain_10": {
      "scene": {
        "id": "rain_dream",
        "name": "校门外的雨",
        "type": "major"
      },
      "segments": [
        {
          "text": "青色血管从她手背浮出来，尸斑沿腕口向上蔓延。"
        },
        {
          "text": "伞外的人群仍在走，没有一个人回头。"
        },
        {
          "text": "初南！",
          "speaker": "林厌",
          "effect": "shake"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "挣开眼睛",
          "next": "ch00_night_01",
          "effect": "blackout"
        }
      ]
    },
    "ch00_night_01": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major",
        "description": "空调把宽阔卧室吹得发冷，翻页钟在黑暗里泛着绿光，厚地毯吞掉了所有脚步声。",
        "arrival": "你从床上翻身坐起，喉咙里还压着刚才那声喊。"
      },
      "segments": [
        {
          "text": "十四年后，凌晨四点。",
          "speaker": "系统"
        },
        {
          "text": "汗水沿后颈滑进吊带背心，你的手仍保持着向前抓握的姿势。"
        },
        {
          "text": "床边没有伞，也没有陈初南。"
        }
      ],
      "progress": 1,
      "ambient": "static",
      "choices": [
        {
          "text": "看一眼翻页钟",
          "next": "ch00_night_02"
        }
      ]
    },
    "ch00_night_02": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "时针刚越过四点，秒页机械地翻下一格。"
        },
        {
          "text": "床头放着半杯水。抽屉没有关严，里面露出一只没有标签的白色药瓶。"
        },
        {
          "text": "空调风吹过杯口，水面轻轻颤了一下。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "先喝一口水",
          "next": "ch00_night_water_cb"
        },
        {
          "text": "按亮床头灯",
          "next": "ch00_night_light_cb"
        }
      ]
    },
    "ch00_night_water_cb": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "杯沿磕到牙齿，凉水灌进喉咙。"
        },
        {
          "text": "你喝得太急，手肘撞上抽屉，里面的东西散落到地毯上。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "弯腰去捡",
          "next": "ch00_night_04"
        }
      ]
    },
    "ch00_night_light_cb": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "灯光骤亮，你眯起眼。镜子里只有一个脸色苍白、满头冷汗的女人。"
        },
        {
          "text": "你拉抽屉时用力过猛，药瓶和几件小物滚落到地毯上。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "捡起白色药瓶",
          "next": "ch00_night_04"
        }
      ]
    },
    "ch00_night_04": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "白色药瓶滚到床脚才停下。你把它捡起来，瓶里的药片撞出细碎声响。"
        },
        {
          "text": "翻页钟又落下一格，声音在空房里格外清楚。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "倒出两粒药",
          "next": "ch00_night_05"
        }
      ]
    },
    "ch00_night_05": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "两粒药停在掌心。你仰头把它们咽下，剩下的凉水顺着唇角流到颈侧。"
        },
        {
          "text": "你刚抬手，另一方白手帕先贴了上来。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "抓住拿手帕的手",
          "next": "ch00_night_06"
        }
      ]
    },
    "ch00_night_06": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "那只手没有躲。手帕柔软，掌心有稳定的温度。"
        },
        {
          "text": "拿这个擦。",
          "speaker": "陈初南"
        },
        {
          "text": "声音贴着床沿响起，近得不需要回头确认。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "“初南。”",
          "next": "ch00_night_07"
        }
      ]
    },
    "ch00_night_07": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "初南……",
          "speaker": "林厌"
        },
        {
          "text": "陈初南坐在床边，仍穿着那件洁白校服。她的脸完整、干净，眼睛里映着床头灯。"
        },
        {
          "text": "又做噩梦了？",
          "speaker": "陈初南"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "勾住她的小指",
          "next": "ch00_night_hook_cb",
          "changes": {
            "val": 4,
            "addFlag": "reached_for_warmth",
            "set": {
              "dream_response": "touch"
            }
          }
        },
        {
          "text": "把手抽回来",
          "next": "ch00_night_withdraw_cb",
          "changes": {
            "val": -3,
            "addFlag": "refused_dream_warmth",
            "set": {
              "dream_response": "withdraw"
            }
          }
        }
      ]
    },
    "ch00_night_hook_cb": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "你的小指扣住她。温润的皮肤没有穿透，也没有剥落。"
        },
        {
          "text": "陈初南把手翻过来，让你握得更稳。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "确认她的脉搏",
          "next": "ch00_night_09"
        }
      ]
    },
    "ch00_night_withdraw_cb": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "你把手藏进被角，白手帕落在膝上。"
        },
        {
          "text": "陈初南没有追过来，只把掌心摊在你看得见的地方。"
        }
      ],
      "progress": 1,
      "choices": [
        {
          "text": "看着她的掌心",
          "next": "ch00_night_09"
        }
      ]
    },
    "ch00_night_09": {
      "scene": {
        "id": "lin_bedroom_night",
        "name": "林家卧室·凌晨",
        "type": "major"
      },
      "segments": [
        {
          "text": "她腕间有脉搏，皮肤也带着活人的温度。"
        },
        {
          "text": "好啦，我回来了。",
          "speaker": "陈初南"
        },
        {
          "text": "床头灯落在她睫毛上，连影子都和从前一样。"
        }
      ],
